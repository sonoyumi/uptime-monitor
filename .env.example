# Скопируйте в .env и заполните. Сам .env в git не попадает.

# Файл со списком мониторов и база истории
MONITORS_FILE=monitors.toml
DATABASE_PATH=data/uptime.db
# Сколько дней хранить результаты проверок (инциденты хранятся всегда)
RETENTION_DAYS=90

# Уведомления в Telegram: токен бота от @BotFather и ID чата (свой ID — у @userinfobot, группа — начинается с -100)
# Пусто — тревоги пишутся только в лог.
BOT_TOKEN=
CHAT_ID=

# Страница статуса и /metrics. 127.0.0.1 — только с этого компьютера; наружу — через nginx.
HOST=127.0.0.1
PORT=8090
STATUS_TITLE=Статус сервисов
